# ============================================================
# Mexpo Frontend — Environment Variables (.env.example)
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# ----- API base URLs (src/global.ts) -----
# SSR/server-side requests use NEXT_PUBLIC_BASE_URL_DEVELOPMENT.
# Browser/client requests use NEXT_PUBLIC_BASE_URL_PRODUCTION.
NEXT_PUBLIC_BASE_URL_DEVELOPMENT=http://localhost:3500
NEXT_PUBLIC_BASE_URL_PRODUCTION=https://mexpo-api.smktelkom-mlg.sch.id

# ----- HTTP Basic Auth (must match backend BASIC_AUTH_*) -----
# Sent on public-api / user-creation / reports endpoints.
NEXT_PUBLIC_BASIC_AUTH_USERNAME=change_me
NEXT_PUBLIC_BASIC_AUTH_PASSWORD=change_me

# ----- Auth token cookie key (src/global.ts TOKEN_KEY; the http-only cookie is written as "token") -----
# Optional — only used as a constant name today; cookie name is hardcoded to "token".
NEXT_PUBLIC_TOKEN_KEY=mexpo-token

# ----- Legacy / removed -----
# NEXT_PUBLIC_ENCRYPT_SECRET — removed: the AES encrypt/decrypt round-trip ran
#   entirely server-side and corrupted UTF-8 responses; payloads are now sent as
#   plain JSON. Do not reintroduce without a real client-side encryption design.
# NEXT_PUBLIC_APP_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RESEND_API_KEY=
