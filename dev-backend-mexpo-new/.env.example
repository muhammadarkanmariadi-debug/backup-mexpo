# ============================================================
# Mexpo Backend — Environment Variables (.env.example)
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# ----- Server -----
# Port the NestJS app listens on
PORT=3500
NODE_ENV=development
# Set to 1 only when deployed as a Vercel serverless function
# (src/main.ts uses it to pick the serverless handler).
VERCEL=

# ----- Database — Hybrid (PostgreSQL or MySQL) -----
# The connection is COMPOSED from individual parameters (no single-string
# DATABASE_URL needed). Used by src/prisma/prisma.service.ts (runtime, via the
# matching driver adapter) AND by prisma.config.ts (Prisma CLI: migrate /
# generate / seed).
#
# The provider is DB_PROVIDER (mysql|postgresql); it must match the schema
# datasource provider — run `npm run db:provider:mysql` / `npm run db:provider:postgres`
# before `npm run build` / `prisma migrate deploy`.
#
# Option A — PostgreSQL (Supabase), RECOMMENDED:
# Prefer the POOLER (session mode, port 5432) which resolves over IPv4; the old
# direct host `db.<ref>.supabase.co` is IPv6-only in some regions and
# unreachable on typical networks.
# Get the values from: Supabase Dashboard -> Project Settings -> Database.
# NOTE: DB_SSLMODE=no-verify (not `require`) — newer `pg` treats `require` as
# strict verify-full and fails on Supabase's certificate chain.
DB_PROVIDER=postgresql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.<project-ref>
DB_PASSWORD=<db-password>
DB_NAME=postgres
DB_SSLMODE=no-verify

# Option B — MySQL/MariaDB (alternative). Example:
# DB_PROVIDER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=mexpo
# DB_PASSWORD=<password>
# DB_NAME=mexpo

# Optional: a full DATABASE_URL overrides the individual parameters above
# (backward compatible). Uncomment only if you prefer the single string:
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify

# Only required for `npx prisma migrate dev` (shadow database for drift detection).
# Leave unset so Prisma auto-creates one on the same server; can stay unset for `migrate deploy` / `db push`.
# SHADOW_DATABASE_URL=

# ----- Auth / JWT -----
# REQUIRED. The app fails fast if this is unset (no fallback secret is used).
# Use a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=change_me_to_a_long_random_string

# ----- HTTP Basic Auth -----
# Protects /public-api, /reports and user-creation/reset endpoints.
# Must match the frontend NEXT_PUBLIC_BASIC_AUTH_USERNAME/PASSWORD.
BASIC_AUTH_USERNAME=change_me
BASIC_AUTH_PASSWORD=change_me

# ----- Frontend -----
# Used to build links in emails (verify email, reset password, temp credentials).
PUBLIC_FRONTEND_URL=http://localhost:3000

# ----- SMTP Mail (nodemailer — src/mail) -----
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# 'true' => TLS (usually port 465) ; 'false' => STARTTLS (usually port 587)
MAIL_SECURE=false
MAIL_USER=no-reply@example.com
MAIL_PASSWORD=your_mail_password
# Inbox that receives public contact form submissions (`POST /contact`).
CONTACT_DESTINATION_EMAIL=tefa@smktelkom-mlg.sch.id

# ----- Object storage (MinIO/S3-compatible) -----
# Public URL prefix embedded in stored file URLs (photos, logos, proofs).
MINIO_ENDPOINT=http://localhost:9000
# Endpoint the AWS SDK uploads to (can differ from the public URL).
MINIO_ENDPOINT_UPLOAD=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
# Bucket used by the users module for profile photos.
MINIO_BUCKET=expo-project
AWS_REGION=us-east-1

# ----- Payment Gateway (Midtrans Snap) -----
# Sandbox keys (copy from Midtrans dashboard; NEVER commit production keys).
# MIDTRANS_IS_PRODUCTION=false changes the Snap base URL to app.sandbox.midtrans.com.
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXXX
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXXX
# 3DS: enable secure credit-card flow (true recommended).
MIDTRANS_IS_3DS=true
# Snap token expiry in minutes (1440 = 24h) — expired PENDING transactions are
# lazily marked EXPIRED on read and via the Midtrans `expire` notification.
MIDTRANS_PAYMENT_EXPIRY=1440
# Platform fee deducted per PAID transaction before payout (percentage).
PAYMENT_PLATFORM_FEE_PERCENT=5

# ----- Google OAuth (GIS id_token verification) -----
# Web client id + secret (secret only needed for OAuth redirect/refresh, kept
# for compatibility; the GIS flow verifies the id_token with the client id).
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>

# ----- Partner & School Website Integration -----
MEXPO_INTEGRATION_API_KEY=mexpo_live_default_secret_key
MEXPO_WEBHOOK_SECRET=mexpo_live_default_secret_key

