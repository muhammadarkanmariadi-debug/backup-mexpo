# ============================================================
# Mexpo Backend — Environment Variables (.env.example)
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# ----- Server -----
# Port the NestJS app listens on
PORT=3500
NODE_ENV=development

# ----- Database — Supabase (Postgres) -----
# Used by src/prisma/prisma.service.ts (runtime, via @prisma/adapter-pg)
# AND by prisma.config.ts (Prisma CLI: migrate / generate / seed).
#
# Supabase connection string. Prefer the POOLER (session mode, port 5432)
# which resolves over IPv4; the old direct host `db.<ref>.supabase.co` is
# IPv6-only in some regions and unreachable on typical networks.
#
# Format:
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify
#
# Get it from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI / Prisma
# NOTE: use `sslmode=no-verify` (not `require`) — newer `pg` treats `require` as strict
# verify-full and fails on Supabase's certificate chain. no-verify keeps TLS encryption
# while skipping CA validation.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify

# Only required for `npx prisma migrate dev` (shadow database for drift detection).
# Leave unset so Prisma auto-creates one on the same server; can stay unset for `migrate deploy` / `db push`.
# SHADOW_DATABASE_URL=

# ----- Auth / JWT -----
# REQUIRED. The app fails fast if this is unset (no fallback secret is used).
# Use a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=change_me_to_a_long_random_string

# ----- HTTP Basic Auth -----
# Protects /public-api, /reports and user-creation/reset endpoints.
# Must match the frontend NEXT_PUBLIC_BASIC_AUTH_USERNAME/PASSWORD.
BASIC_AUTH_USERNAME=change_me
BASIC_AUTH_PASSWORD=change_me

# ----- Frontend -----
# Used to build links in emails (verify email, reset password, temp credentials).
PUBLIC_FRONTEND_URL=http://localhost:3000

# ----- SMTP Mail (nodemailer — src/mail) -----
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# 'true' => TLS (usually port 465) ; 'false' => STARTTLS (usually port 587)
MAIL_SECURE=false
MAIL_USER=no-reply@example.com
MAIL_PASSWORD=your_mail_password

# ----- Object storage (MinIO/S3-compatible) -----
# Public URL prefix embedded in stored file URLs (photos, logos, proofs).
MINIO_ENDPOINT=http://localhost:9000
# Endpoint the AWS SDK uploads to (can differ from the public URL).
MINIO_ENDPOINT_UPLOAD=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
# Bucket used by the users module for profile photos.
MINIO_BUCKET=expo-project
AWS_REGION=us-east-1
